# Required — API keys
GOOGLE_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_HOST=https://your-index-name.svc.environment.pinecone.io

# Required — deployment
ALLOWED_ORIGIN=https://your-frontend-domain.com
TOKEN_SECRET=output-of-openssl-rand-hex-32
PROMPT_BUCKET=your-gcs-bucket-name

# Required — magic-link email (Gmail)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional — defaults shown
APP_URL=https://mporter-dohmh.github.io/law-bot
