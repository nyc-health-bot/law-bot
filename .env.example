# Required — API keys
GOOGLE_API_KEY: "your-gemini-api-key"
PINECONE_API_KEY: "your-pinecone-api-key"
PINECONE_HOST: "https://your-index-name.svc.environment.pinecone.io"

# Required — deployment
ALLOWED_ORIGIN: "https://your-frontend-domain.com"
PROMPT_BUCKET: "your-gcs-bucket-name"


# Optional — Google Sheet that ratings are appended to
FEEDBACK_SHEET_ID: "your-google-sheet-id"
